# OpenClaw OTEL Stack Environment Variables
# Copy this to .env and customize as needed

# Data storage location (must exist on your system)
DATA_PATH=/mnt/dev/openclaw-otel/data

# Grafana settings
GRAFANA_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin

# Retention periods
PROMETHEUS_RETENTION=30d
TEMPO_RETENTION=168h

# Resource limits (optional, uncomment to use)
# OTEL_COLLECTOR_MEMORY=1G
# TEMPO_MEMORY=2G
# PROMETHEUS_MEMORY=2G
# GRAFANA_MEMORY=1G

# Network ports (change if you have conflicts)
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# TEMPO_PORT=3200
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
